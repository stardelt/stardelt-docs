        <mxCell id="example-matrix" value="Same pattern everywhere:  catalog → Lakekeeper (alt: Polaris) · storage → SeaweedFS (alt: any S3) · orchestration → Airflow (alt: Dagster) · identity → Keycloak (alt: any OIDC IdP) · LLM → vLLM (alt: external API, opt-in)" style="text;html=1;fontColor=#a4b3ff;fontSize=11;align=left;verticalAlign=top;spacing=8;whiteSpace=wrap;" vertex="1" parent="1">
