<mxfile host="app.diagrams.net" agent="stardelt-docs" version="24.7.7">
  <diagram id="stardelt-plug-pattern" name="the plug pattern">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bg" value="" style="rounded=0;fillColor=#0d1130;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1200" height="700" as="geometry" />
        </mxCell>
        <mxCell id="title" value="The plug pattern" style="text;html=1;fontColor=#ffffff;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="title-sub" value="The CRD schema is the plug specification. The operator adapter is the socket. Defaults ship — alternates slot in without touching the architecture." style="text;html=1;fontColor=#a4b3ff;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="38" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="crd" value="Kubernetes CRD&#10;(your intent)" style="rounded=1;fillColor=#1a2256;strokeColor=#5b6cff;fontColor=#ffffff;fontSize=14;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="crd-yaml" value="kind: Pipeline&#10;name: taxi-load&#10;engine: airflow&#10;steps:&#10;  - ingest&#10;  - transform&#10;  - test" style="text;html=1;fontColor=#a4b3ff;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacing=8;fillColor=#0e1228;strokeColor=#5b6cff;strokeOpacity=0.3;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="270" width="180" height="115" as="geometry" />
        </mxCell>

        <mxCell id="adapter" value="stardelt operator adapter&#10;(the socket)" style="rounded=1;fillColor=#1e2a78;fillOpacity=0.6;strokeColor=#5b6cff;fontColor=#ffffff;fontSize=14;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="240" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="adapter-note" value="default wiring&#10;SSO + policy glue&#10;lineage emission&#10;upgrades + HA" style="text;html=1;fontColor=#a4b3ff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="300" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="default-impl" value="Apache Airflow&#10;default — shipped, wired, tested" style="rounded=1;fillColor=#1a2256;strokeColor=#5b6cff;fontColor=#ffffff;fontSize=13;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="140" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="alt-impl" value="Dagster&#10;alternate — one field swap" style="rounded=1;fillColor=#11152b;strokeColor=#5b6cff;strokeOpacity=0.5;dashed=1;fontColor=#ffffff;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="410" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="outcome" value="Either way, identical downstream:&#10;the same Iceberg table · the same lineage · the same quality gates · the same audit trail" style="rounded=1;fillColor=#1e2a78;fillOpacity=0.35;strokeColor=#5b6cff;fontColor=#ffffff;fontSize=13;fontStyle=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="920" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="reconciles" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#5b6cff;endArrow=blockThin;endFill=1;fontColor=#a4b3ff;fontSize=10;html=1;" edge="1" parent="1" source="crd" target="adapter">
